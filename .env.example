# ------------------------------------------------------------------
# Velinno  environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets.
# ------------------------------------------------------------------

# ---- Email delivery (pick ONE path) ---------------------------------
# Option A: Resend (recommended)
#   Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender shown to recipients. Must be a verified domain in Resend,
# e.g. "Velinno <hello@velinno.com>"
RESEND_FROM=

# Option B: Nodemailer / SMTP (fallback when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Recipients ------------------------------------------------------
# Inbox that receives contact-form submissions (team notification).
CONTACT_RECEIVER_EMAIL=hello@velinno.com

# ---- Database (lead backup storage) ---------------------------------
# Supabase project URL + service-role key (https://supabase.com).
# The `contact_submissions` table is created with the SQL in the README.
# If these are missing, the contact form still works  it just logs a
# warning and skips storage (email delivery continues).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
